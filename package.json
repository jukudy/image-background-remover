{
  "name": "image-background-remover",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:d1:migrate:local": "wrangler d1 migrations apply clearcut-auth --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply clearcut-auth --remote",
    "auth:local:migrate": "node scripts/run-local-bin.mjs wrangler d1 migrations apply clearcut-auth --local",
    "auth:local:doctor": "node scripts/auth-local-doctor.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "wrangler": "^4.114.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

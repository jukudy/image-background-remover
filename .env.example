# Public site URL used for canonical links and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret

# Public Cloudflare Turnstile widget key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
TURNSTILE_SECRET_KEY=
REMOVE_BG_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ENV=development
